{
  "name": "servlink",
  "version": "1.0.2",
  "description": "slink: zero-trust outbound Ed25519-authenticated server tunnel to any compatible relay server, with loopback target lock, local rate/body guards and wake/sleep hooks",
  "type": "module",
  "bin": {
    "slink": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsx --test --test-concurrency=1 test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tunnel",
    "localhost",
    "zero-trust",
    "reverse-proxy",
    "websocket",
    "ed25519"
  ],
  "license": "MIT",
  "author": "Sarthak Kamon <kamonsarthak@hotmail.com> (https://github.com/kamonsarthak)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamonsarthak/servlink.git"
  },
  "homepage": "https://github.com/kamonsarthak/servlink#readme",
  "bugs": {
    "url": "https://github.com/kamonsarthak/servlink/issues"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
